# Non-secret Vaultwarden configuration contract.
# Copy key names into the target platform configuration; inject actual values
# through its protected secret mechanism. Do not commit a populated .env file.

# Public HTTPS origin; no trailing slash.
DOMAIN=https://vault.example.com

# Persist this directory on a durable encrypted volume when using SQLite.
DATA_FOLDER=/data

# Disable public self-registration unless explicitly approved.
SIGNUPS_ALLOWED=false

# SMTP configuration: values below are placeholders only.
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=<vault-sender@example.com>
SMTP_USERNAME=<secret-store-reference>
SMTP_PASSWORD=<secret-store-reference>

# Keep administrative capability disabled unless explicitly required.
# ADMIN_TOKEN=<secret-store-reference>

# Configure only according to the selected Vaultwarden image documentation.
# WEBSOCKET_ENABLED=true
