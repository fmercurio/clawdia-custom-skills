# Non-secret, non-runnable configuration contract; no deployment authorization.
# Do not import this file verbatim or commit a populated copy.
# Platform environment values are inspectable by privileged operators, not host isolation.
# Resolve protected references via a separately reviewed secret-store integration.
# Never expose values in shell arguments, model-visible tool results or public files.

# Reserved example only. Match the approved canonical public HTTPS origin.
DOMAIN=https://vault.example.com

# Container mount destination, NOT a host-local path.
# Require encrypted persistent storage and one replica for local SQLite.
# External SQL does not remove persistent file-storage requirements.
DATA_FOLDER=/data

# Confirm effective values, including persisted admin configuration overrides.
SIGNUPS_ALLOWED=false
SIGNUPS_DOMAINS_WHITELIST=
INVITATIONS_ALLOWED=false

# No implicit first-account bootstrap. Invitations/account creation need approval.
# Optional SMTP block: enable only under a specific configuration grant.
# Sending test email requires a separate approved recipient and send grant.
# SMTP_HOST=<approved-smtp-host>
# SMTP_PORT=<approved-smtp-port>
# SMTP_SECURITY=<reviewed-starttls-or-force-tls-mode>
# SMTP_FROM=<approved-sender@example.com>
# SMTP_USERNAME=<secret-store-reference>
# SMTP_PASSWORD=<secret-store-reference>

# Administration absent by default; enabling requires owner approval and
# network/proxy restriction. This marker is not an automatically resolved secret.
# ADMIN_TOKEN=<secret-store-reference>

# Pin the official image digest in a separate reviewed deployment artifact.
# Verify current-release HTTP/WebSocket routing; no legacy toggle or port assumed.
# Never store a BW_SESSION value in this or any other file.
