[Unit]
Description={SERVICE_LABEL}
After=network.target

# Strict render-only template. Binding is configured through the rendered config.
[Service]
Type=simple
WorkingDirectory={INSTANCE_DIR}
Environment=SECOND_BRAIN_KIT_RUNTIME={RUNTIME_ROOT}
Environment=SECOND_BRAIN_KIT_PYTHON={RUNTIME_PYTHON}
ExecStart=/bin/bash {LAUNCHER_PATH} --config {CONFIG_PATH}
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=4
StandardOutput=append:{STDOUT_LOG_PATH}
StandardError=append:{STDERR_LOG_PATH}
